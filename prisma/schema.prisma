datasource db {
  // PostgreSQL e o banco oficial do projeto (ver docs/memory-ai.md §1).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RecordStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum InventoryReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  EXPIRED
}

enum StockMovementType {
  PURCHASE_ENTRY
  SALE_RESERVATION
  SALE_CONFIRMATION
  RESERVATION_RELEASE
  MANUAL_ADJUSTMENT
  RETURN
  LOSS
}

enum ProductStockStatus {
  IN_STOCK
  OUT_OF_STOCK
  ON_BACKORDER
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
  FREE_SHIPPING
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_CART
  FIXED_PRODUCT
}

enum VipMembershipStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum OrderItemType {
  PRODUCT_VARIANT
  TRAINING_SESSION
}

/// Estado da solicitacao de cotacao. Nenhum estado cobra ou reserva estoque:
/// a negociacao e o fechamento acontecem fora do site (ERP).
enum QuoteStatus {
  REQUESTED
  IN_REVIEW
  ANSWERED
  WON
  LOST
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD
  PIX
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentEnvironment {
  TEST
  PRODUCTION
}

enum SmtpSecurity {
  NONE
  STARTTLS
  SSL_TLS
}

enum EmailEventKey {
  ACCOUNT_CREATED
  ORDER_CREATED
  PAYMENT_PENDING
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  ORDER_STATUS_CHANGED
  PASSWORD_RESET
  QUOTE_REQUESTED
  QUOTE_STATUS_CHANGED
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  RETRY
  FAILED
}

enum ShippingQuoteStatus {
  QUOTED
  EXPIRED
  SELECTED
}

enum ShipmentStatus {
  PENDING
  PURCHASED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TrainingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TrainingSessionStatus {
  DRAFT
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  RESERVED
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  RETRY
  FAILED
}

enum JobType {
  RELEASE_EXPIRED_RESERVATIONS
  RECONCILE_PAYMENT
  SEND_TRANSACTIONAL_EMAIL
  GENERATE_REPORT
  CLEAN_EXPIRED_CARTS
}

enum ActorType {
  USER
  SYSTEM
  PROVIDER
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                String             @id @default(cuid())
  publicId          String             @unique @default(cuid())
  email             String             @unique @db.VarChar(191)
  passwordHash      String             @db.VarChar(255)
  status            UserStatus         @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  profile           CustomerProfile?
  addresses         Address[]
  roles             UserRole[]
  carts             Cart[]
  orders            Order[]
  couponRedemptions CouponRedemption[]
  vipMemberships    VipMembership[]
  reportExports     ReportExport[]
  favorites         CustomerFavorite[]
  quotes            Quote[]            @relation("QuoteRequester")
  assignedQuotes    Quote[]            @relation("QuoteAssignee")
  auditActorId      String?
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique @db.VarChar(100)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(150)
  description String?          @db.VarChar(255)
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CustomerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String   @db.VarChar(100)
  lastName    String   @db.VarChar(100)
  phone       String?  @db.VarChar(30)
  document    String?  @db.VarChar(30)
  consentJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id            String   @id @default(cuid())
  publicId      String   @unique @default(cuid())
  userId        String
  label         String   @db.VarChar(80)
  recipientName String   @db.VarChar(160)
  street        String   @db.VarChar(180)
  number        String   @db.VarChar(20)
  complement    String?  @db.VarChar(120)
  district      String   @db.VarChar(120)
  city          String   @db.VarChar(120)
  state         String   @db.VarChar(2)
  postalCode    String   @db.VarChar(12)
  country       String   @default("BR") @db.VarChar(2)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Brand {
  id               String            @id @default(cuid())
  publicId         String            @unique @default(cuid())
  legacySource     String?           @db.VarChar(80)
  legacyId         String?           @db.VarChar(191)
  name             String            @unique @db.VarChar(160)
  slug             String            @unique @db.VarChar(191)
  description      String?           @db.Text
  imagePath        String?           @db.VarChar(500)
  status           RecordStatus      @default(DRAFT)
  parentId         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  parent           Brand?            @relation("BrandHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Brand[]           @relation("BrandHierarchy")
  products         Product[]
  promotionScopes  PromotionScope[]
  couponBrandRules CouponBrandRule[]

  @@unique([legacySource, legacyId])
  @@index([parentId, status])
}

model Category {
  id                  String               @id @default(cuid())
  publicId            String               @unique @default(cuid())
  legacySource        String?              @db.VarChar(80)
  legacyId            String?              @db.VarChar(191)
  name                String               @unique @db.VarChar(160)
  slug                String               @unique @db.VarChar(191)
  status              RecordStatus         @default(DRAFT)
  parentId            String?
  imagePath           String?              @db.VarChar(500)
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  parent              Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children            Category[]           @relation("CategoryHierarchy")
  products            ProductCategory[]
  promotionScopes     PromotionScope[]
  couponCategoryRules CouponCategoryRule[]

  @@unique([legacySource, legacyId])
  @@index([parentId, status])
  @@index([status, sortOrder])
}

model Product {
  id                 String              @id @default(cuid())
  legacySource       String?             @db.VarChar(80)
  legacyId           String?             @db.VarChar(191)
  publicId           String              @unique @default(cuid())
  name               String              @db.VarChar(220)
  slug               String              @unique @db.VarChar(191)
  description        String?             @db.Text
  status             RecordStatus        @default(DRAFT)
  brandId            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  images             ProductImage[]
  favorites          CustomerFavorite[]
  categories         ProductCategory[]
  segments           ProductSegment[]
  tags               ProductTag[]
  promotionScopes    PromotionScope[]
  couponProductRules CouponProductRule[]

  @@unique([legacySource, legacyId])
  @@index([status, createdAt])
  @@index([brandId, status])
  @@index([name, status])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Segment {
  id           String           @id @default(cuid())
  publicId     String           @unique @default(cuid())
  legacySource String?          @db.VarChar(80)
  legacyId     String?          @db.VarChar(191)
  name         String           @unique @db.VarChar(160)
  slug         String           @unique @db.VarChar(191)
  description  String?          @db.Text
  imagePath    String?          @db.VarChar(500)
  status       RecordStatus     @default(ACTIVE)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  products     ProductSegment[]

  @@unique([legacySource, legacyId])
  @@index([status, sortOrder])
}

model ProductSegment {
  productId String
  segmentId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([productId, segmentId])
  @@index([segmentId])
}

model Tag {
  id           String       @id @default(cuid())
  publicId     String       @unique @default(cuid())
  legacySource String?      @db.VarChar(80)
  legacyId     String?      @db.VarChar(191)
  name         String       @unique @db.VarChar(160)
  slug         String       @unique @db.VarChar(191)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  products     ProductTag[]

  @@unique([legacySource, legacyId])
  @@index([status, name])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model ProductVariant {
  id                  String                 @id @default(cuid())
  publicId            String                 @unique @default(cuid())
  productId           String
  sku                 String                 @unique @db.VarChar(100)
  priceCents          Int
  compareAtPriceCents Int?
  weightGrams         Int?
  widthMm             Int?
  heightMm            Int?
  lengthMm            Int?
  manageStock         Boolean                @default(true)
  stockStatus         ProductStockStatus     @default(IN_STOCK)
  lowStockThreshold   Int?
  status              RecordStatus           @default(DRAFT)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  product             Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  images              ProductImage[]
  inventoryBalance    InventoryBalance?
  cartItems           CartItem[]
  orderItems          OrderItem[]
  reservations        InventoryReservation[]
  stockMovements      StockMovement[]
  quoteItems          QuoteItem[]

  @@index([productId, status])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  path      String          @db.VarChar(500)
  altText   String?         @db.VarChar(255)
  sortOrder Int             @default(0)
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
}

model CustomerFavorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model InventoryBalance {
  id               String         @id @default(cuid())
  variantId        String         @unique
  physicalQuantity Int            @default(0)
  reservedQuantity Int            @default(0)
  updatedAt        DateTime       @updatedAt
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model InventoryReservation {
  id          String                     @id @default(cuid())
  publicId    String                     @unique @default(cuid())
  orderId     String
  variantId   String
  quantity    Int
  status      InventoryReservationStatus @default(PENDING)
  expiresAt   DateTime
  confirmedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime                   @default(now())
  order       Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant             @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([orderId, variantId])
}

model StockMovement {
  id             String            @id @default(cuid())
  variantId      String
  orderId        String?
  type           StockMovementType
  quantity       Int
  beforeQuantity Int
  afterQuantity  Int
  reason         String?           @db.VarChar(255)
  createdAt      DateTime          @default(now())
  variant        ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
}

model Cart {
  id             String          @id @default(cuid())
  publicId       String          @unique @default(cuid())
  userId         String?
  anonymousToken String?         @unique @db.VarChar(255)
  status         CartStatus      @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          CartItem[]
  shippingQuotes ShippingQuote[]

  @@index([userId, status])
  @@index([status, expiresAt])
}

model CartItem {
  id             String         @id @default(cuid())
  cartId         String
  variantId      String
  quantity       Int
  unitPriceCents Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Promotion {
  id        String           @id @default(cuid())
  publicId  String           @unique @default(cuid())
  name      String           @db.VarChar(180)
  type      PromotionType
  status    PromotionStatus  @default(DRAFT)
  value     Int?
  exclusive Boolean          @default(false)
  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  scopes    PromotionScope[]
  coupons   Coupon[]

  @@index([status, startsAt, endsAt])
}

model PromotionScope {
  id          String    @id @default(cuid())
  promotionId String
  productId   String?
  brandId     String?
  categoryId  String?
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand       Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([productId])
  @@index([brandId])
  @@index([categoryId])
}

model Coupon {
  id                   String                   @id @default(cuid())
  code                 String                   @unique @db.VarChar(80)
  description          String?                  @db.Text
  status               CouponStatus             @default(ACTIVE)
  discountType         CouponDiscountType       @default(FIXED_CART)
  discountValue        Int                      @default(0)
  allowFreeShipping    Boolean                  @default(false)
  individualUse        Boolean                  @default(false)
  excludeSaleItems     Boolean                  @default(false)
  promotionId          String?
  usageLimit           Int?
  usageCount           Int                      @default(0)
  perCustomerLimit     Int?
  minimumSubtotalCents Int?
  maximumSubtotalCents Int?
  maxEligibleItems     Int?
  startsAt             DateTime
  endsAt               DateTime?
  promotion            Promotion?               @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  redemptions          CouponRedemption[]
  productRules         CouponProductRule[]
  brandRules           CouponBrandRule[]
  categoryRules        CouponCategoryRule[]
  emailRestrictions    CouponEmailRestriction[]

  @@index([status, startsAt, endsAt])
}

model CouponProductRule {
  couponId  String
  productId String
  excluded  Boolean @default(false)
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponBrandRule {
  couponId String
  brandId  String
  excluded Boolean @default(false)
  coupon   Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  brand    Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([couponId, brandId])
  @@index([brandId])
}

model CouponCategoryRule {
  couponId   String
  categoryId String
  excluded   Boolean  @default(false)
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

model CouponEmailRestriction {
  id       String @id @default(cuid())
  couponId String
  pattern  String @db.VarChar(191)
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, pattern])
  @@index([couponId])
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  userId        String?
  customerEmail String?  @db.VarChar(191)
  orderId       String?  @unique
  redeemedAt    DateTime @default(now())
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId, userId])
  @@index([couponId, customerEmail])
}

model VipTier {
  id          String          @id @default(cuid())
  name        String          @unique @db.VarChar(100)
  rank        Int             @unique
  discountBps Int             @default(0)
  createdAt   DateTime        @default(now())
  memberships VipMembership[]
}

model VipMembership {
  id        String              @id @default(cuid())
  userId    String
  tierId    String
  status    VipMembershipStatus @default(ACTIVE)
  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      VipTier             @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([userId, status, startsAt, endsAt])
}

model Order {
  id                    String                 @id @default(cuid())
  publicId              String                 @unique @default(cuid())
  userId                String?
  status                OrderStatus            @default(DRAFT)
  subtotalCents         Int
  discountCents         Int                    @default(0)
  shippingCents         Int                    @default(0)
  totalCents            Int
  currency              String                 @default("BRL") @db.Char(3)
  contactEmail          String                 @db.VarChar(191)
  shippingMethodCode    String?                @db.VarChar(100)
  shippingProvider      String?                @db.VarChar(100)
  shippingDays          Int?
  shippingAddressJson   Json?
  billingAddressJson    Json?
  placedAt              DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  payments              Payment[]
  inventoryReservations InventoryReservation[]
  stockMovements        StockMovement[]
  shippingQuotes        ShippingQuote[]
  shipment              Shipment?
  enrollments           Enrollment[]
  couponRedemption      CouponRedemption?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                String           @id @default(cuid())
  orderId           String
  itemType          OrderItemType
  variantId         String?
  trainingSessionId String?
  name              String           @db.VarChar(220)
  sku               String?          @db.VarChar(100)
  quantity          Int
  unitPriceCents    Int
  totalCents        Int
  metadataJson      Json?
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@index([trainingSessionId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  ActorType
  actorId    String?
  reason     String?      @db.VarChar(255)
  source     String?      @db.VarChar(100)
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id              String           @id @default(cuid())
  publicId        String           @unique @default(cuid())
  orderId         String
  method          PaymentMethod
  status          PaymentStatus    @default(PENDING)
  provider        String           @db.VarChar(80)
  providerStatus  String?          @db.VarChar(80)
  externalId      String?          @unique @db.VarChar(150)
  amountCents     Int
  currency        String           @default("BRL") @db.Char(3)
  pixQrCode       String?          @db.Text
  pixQrCodeBase64 String?          @db.Text
  pixCopyPaste    String?          @db.Text
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts        PaymentAttempt[]
  events          PaymentEvent[]
  refunds         Refund[]

  @@index([orderId, status])
}

model PaymentAttempt {
  id             String   @id @default(cuid())
  paymentId      String
  idempotencyKey String   @unique @db.VarChar(150)
  externalId     String?  @db.VarChar(150)
  status         String   @db.VarChar(80)
  responseJson   Json?
  createdAt      DateTime @default(now())
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model PaymentEvent {
  id          String    @id @default(cuid())
  paymentId   String?
  provider    String    @db.VarChar(80)
  eventId     String    @unique @db.VarChar(150)
  payloadJson Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([provider, receivedAt])
}

model Refund {
  id          String       @id @default(cuid())
  paymentId   String
  amountCents Int
  reason      String       @db.VarChar(255)
  status      RefundStatus @default(PENDING)
  externalId  String?      @unique @db.VarChar(150)
  createdAt   DateTime     @default(now())
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model ShippingQuote {
  id                    String              @id @default(cuid())
  publicId              String              @unique @default(cuid())
  cartId                String?
  orderId               String?
  status                ShippingQuoteStatus @default(QUOTED)
  provider              String              @db.VarChar(80)
  serviceCode           String              @db.VarChar(100)
  priceCents            Int
  deliveryDays          Int
  originPostalCode      String              @db.VarChar(12)
  destinationPostalCode String              @db.VarChar(12)
  externalQuoteId       String?             @db.VarChar(150)
  expiresAt             DateTime
  createdAt             DateTime            @default(now())
  cart                  Cart?               @relation(fields: [cartId], references: [id], onDelete: SetNull)
  order                 Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([cartId, status])
  @@index([orderId])
  @@index([expiresAt])
}

model Shipment {
  id           String         @id @default(cuid())
  orderId      String         @unique
  status       ShipmentStatus @default(PENDING)
  provider     String?        @db.VarChar(80)
  serviceCode  String?        @db.VarChar(100)
  trackingCode String?        @db.VarChar(150)
  purchasedAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Training {
  id          String            @id @default(cuid())
  publicId    String            @unique @default(cuid())
  name        String            @db.VarChar(220)
  slug        String            @unique @db.VarChar(191)
  description String?           @db.Text
  status      TrainingStatus    @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  sessions    TrainingSession[]
}

model TrainingSession {
  id            String                @id @default(cuid())
  publicId      String                @unique @default(cuid())
  trainingId    String
  startsAt      DateTime
  endsAt        DateTime
  location      String                @db.VarChar(255)
  capacity      Int
  reservedSeats Int                   @default(0)
  status        TrainingSessionStatus @default(DRAFT)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  training      Training              @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  batches       TrainingBatch[]
  enrollments   Enrollment[]
  orderItems    OrderItem[]

  @@index([trainingId, startsAt])
  @@index([status, startsAt])
}

model TrainingBatch {
  id         String          @id @default(cuid())
  sessionId  String
  name       String          @db.VarChar(120)
  priceCents Int
  startsAt   DateTime
  endsAt     DateTime?
  session    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, startsAt])
}

model Enrollment {
  id               String           @id @default(cuid())
  publicId         String           @unique @default(cuid())
  orderId          String
  sessionId        String
  participantName  String           @db.VarChar(160)
  participantEmail String           @db.VarChar(191)
  participantPhone String?          @db.VarChar(30)
  status           EnrollmentStatus @default(RESERVED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  session          TrainingSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, status])
  @@index([orderId])
}

model ScheduledJob {
  id          String    @id @default(cuid())
  type        JobType
  payloadJson Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?   @db.VarChar(100)
  lastError   String?   @db.Text
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([lockedAt])
}

model SiteConfiguration {
  id              String   @id @default("default")
  siteName        String   @default("Comercial do Norte") @db.VarChar(160)
  logoPath        String?  @db.VarChar(500)
  faviconPath     String?  @db.VarChar(500)
  address         String?  @db.VarChar(255)
  phone           String?  @db.VarChar(40)
  whatsapp        String?  @db.VarChar(40)
  instagramUrl    String?  @db.VarChar(500)
  title           String?  @db.VarChar(180)
  description     String?  @db.Text
  homeComposition Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteBanner {
  id          String       @id @default(cuid())
  desktopPath String       @db.VarChar(500)
  mobilePath  String?      @db.VarChar(500)
  eyebrow     String?      @db.VarChar(120)
  title       String?      @db.VarChar(220)
  description String?      @db.Text
  ctaLabel    String?      @db.VarChar(120)
  ctaHref     String?      @db.VarChar(500)
  sortOrder   Int          @default(0)
  status      RecordStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, sortOrder])
}

model PaymentConfiguration {
  id                     String             @id @default("default")
  environment            PaymentEnvironment @default(TEST)
  accessTokenEncrypted   String?            @db.Text
  publicKey              String?            @db.VarChar(255)
  webhookSecretEncrypted String?            @db.Text
  enabled                Boolean            @default(false)
  enablePix              Boolean            @default(true)
  enableCard             Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model SmtpConfiguration {
  id                String       @id @default("default")
  host              String?      @db.VarChar(255)
  port              Int          @default(587)
  username          String?      @db.VarChar(255)
  passwordEncrypted String?      @db.Text
  security          SmtpSecurity @default(STARTTLS)
  fromEmail         String?      @db.VarChar(191)
  fromName          String?      @db.VarChar(160)
  replyTo           String?      @db.VarChar(191)
  enabled           Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model EmailTemplate {
  id        String        @id @default(cuid())
  key       EmailEventKey
  locale    String        @db.VarChar(10)
  subject   String        @db.VarChar(255)
  htmlBody  String        @db.Text
  textBody  String        @db.Text
  enabled   Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([key, locale])
  @@index([key, enabled])
}

model NotificationPreference {
  id                String        @id @default(cuid())
  eventKey          EmailEventKey @unique
  enabled           Boolean       @default(true)
  recipientOverride String?       @db.VarChar(191)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model EmailDelivery {
  id            String              @id @default(cuid())
  dedupeKey     String              @unique @db.VarChar(255)
  eventKey      EmailEventKey
  locale        String              @default("pt-BR") @db.VarChar(10)
  recipient     String              @db.VarChar(191)
  payloadJson   Json
  status        EmailDeliveryStatus @default(PENDING)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(5)
  lastError     String?             @db.Text
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([eventKey, createdAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  action     String    @db.VarChar(120)
  entityType String    @db.VarChar(120)
  entityId   String    @db.VarChar(191)
  beforeJson Json?
  afterJson  Json?
  requestId  String?   @db.VarChar(100)
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String   @unique @db.VarChar(150)
  scope        String   @db.VarChar(100)
  responseJson Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([scope, expiresAt])
}

model ReportExport {
  id           String             @id @default(cuid())
  publicId     String             @unique @default(cuid())
  createdById  String
  type         String             @db.VarChar(100)
  status       ReportExportStatus @default(PENDING)
  filtersJson  Json?
  filePath     String?            @db.VarChar(500)
  errorMessage String?            @db.Text
  createdAt    DateTime           @default(now())
  completedAt  DateTime?
  createdBy    User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

/// Solicitacao de cotacao feita pelo site. Nao cobra, nao reserva estoque e
/// nao gera pedido: apenas registra a intencao e avisa a equipe comercial.
model Quote {
  id            String       @id @default(cuid())
  publicId      String       @unique @default(cuid())
  status        QuoteStatus  @default(REQUESTED)
  customerName  String       @db.VarChar(160)
  customerPhone String       @db.VarChar(40)
  customerEmail String?      @db.VarChar(191)
  companyName   String?      @db.VarChar(160)
  document      String?      @db.VarChar(30)
  notes         String?      @db.Text
  origin        String       @default("site") @db.VarChar(40)
  itemsCount    Int          @default(0)
  subtotalCents Int          @default(0)
  userId        String?
  assignedToId  String?
  expiresAt     DateTime?
  answeredAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User?        @relation("QuoteRequester", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo    User?        @relation("QuoteAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  items         QuoteItem[]
  events        QuoteEvent[]

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([userId])
}

/// Snapshot dos itens no momento da solicitacao (preco vem do servidor).
model QuoteItem {
  id             String          @id @default(cuid())
  quoteId        String
  variantId      String?
  productName    String          @db.VarChar(220)
  productSlug    String          @db.VarChar(191)
  sku            String          @db.VarChar(100)
  imagePath      String?         @db.VarChar(500)
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  createdAt      DateTime        @default(now())
  quote          Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

/// Trilha de auditoria do estado da cotacao.
model QuoteEvent {
  id         String       @id @default(cuid())
  quoteId    String
  fromStatus QuoteStatus?
  toStatus   QuoteStatus
  actorType  ActorType
  actorId    String?
  reason     String?      @db.Text
  createdAt  DateTime     @default(now())
  quote      Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}

/// Categorias de posts do CMS (WordPress-style)
model PostCategory {
  id           String       @id @default(cuid())
  publicId     String       @unique @default(cuid())
  legacySource String?      @db.VarChar(80)
  legacyId     String?      @db.VarChar(191)
  name         String       @unique @db.VarChar(160)
  slug         String       @unique @db.VarChar(191)
  description  String?      @db.Text
  status       RecordStatus @default(ACTIVE)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  posts        Post[]

  @@index([status, sortOrder])
}

/// Posts de artigos e tutoriais (Explica Ai Nort!)
model Post {
  id            String        @id @default(cuid())
  publicId      String        @unique @default(cuid())
  legacySource  String?       @db.VarChar(80)
  legacyId      String?       @db.VarChar(191)
  title         String        @db.VarChar(255)
  slug          String        @unique @db.VarChar(191)
  excerpt       String?       @db.Text
  content       String        @db.Text
  coverUrl      String?       @db.VarChar(500)
  videoUrl      String?       @db.VarChar(500)
  videoDuration String?       @db.VarChar(50)
  authorName    String?       @db.VarChar(160)
  badges        String[]      @default([])
  status        RecordStatus  @default(ACTIVE)
  categoryId    String?
  category      PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedAt   DateTime      @default(now())
  views         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

/// Eventos, workshops, reinauguracoes e feiras
model Event {
  id              String       @id @default(cuid())
  publicId        String       @unique @default(cuid())
  legacySource    String?      @db.VarChar(80)
  legacyId        String?      @db.VarChar(191)
  title           String       @db.VarChar(255)
  slug            String       @unique @db.VarChar(191)
  subtitle        String?      @db.VarChar(255)
  description     String       @db.Text
  posterUrl       String?      @db.VarChar(500)
  eventDate       DateTime?
  eventDateText   String?      @db.VarChar(100)
  eventTime       String?      @db.VarChar(100)
  location        String?      @db.VarChar(255)
  locationAddress String?      @db.VarChar(255)
  instructor      String?      @db.VarChar(160)
  badge           String?      @db.VarChar(80)
  ctaLabel        String?      @db.VarChar(80)
  ctaUrl          String?      @db.VarChar(500)
  status          RecordStatus @default(ACTIVE)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, sortOrder])
}
