{
  "name": "loja-comercial-do-norte",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build && node scripts/copy-web-builds.mjs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "typecheck:seed": "tsc -p tsconfig.seed.json",
    "agents:sync": "node scripts/agents/project-sync.mjs",
    "agents:claim": "node scripts/agents/task-claim.mjs",
    "agents:heartbeat": "node scripts/agents/task-claim.mjs heartbeat",
    "agents:migrate-fields": "node scripts/agents/migrate-project-fields.mjs",
    "agents:schedule": "node scripts/agents/schedule-project.mjs",
    "test": "node scripts/check-workspace.mjs && turbo test",
    "test:e2e": "playwright test",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:backup": "node scripts/dev/postgres-backup.mjs",
    "db:restore": "node scripts/dev/postgres-restore.mjs",
    "test:backup": "node --test scripts/dev/postgres-backup.test.mjs",
    "db:local:init": "node scripts/dev/postgres.mjs init",
    "db:local:start": "node scripts/dev/postgres.mjs start",
    "db:local:stop": "node scripts/dev/postgres.mjs stop",
    "db:import:woocommerce": "tsx scripts/import-woocommerce.ts",
    "verify:local": "node scripts/verify-local.mjs",
    "bootstrap:local": "node scripts/bootstrap-local.mjs",
    "agents:test": "node --test scripts/agents/*.test.mjs",
    "agents:verify": "node scripts/agents/verify-project.mjs",
    "agents:views": "node scripts/agents/setup-views.mjs",
    "agents:hierarchy": "node scripts/agents/setup-hierarchy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@prisma/client": "6.19.3",
    "@types/node": "24.3.1",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.0",
    "sharp": "0.35.4",
    "tsx": "^4.19.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5"
  }
}
