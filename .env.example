# Banco oficial do projeto: PostgreSQL (ver docs/memory-ai.md §1).
# Copie para .env e ajuste para o ambiente local.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/comercial_norte_dev?schema=public&connection_limit=5"
PORT=3000
APP_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:5174
COOKIE_SECRET=replace-with-a-long-random-local-secret
CRON_SECRET=replace-with-a-long-random-local-secret
# Base64 de 32 bytes; obrigatório em produção para cifrar tokens e senhas.
SETTINGS_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
# Contas criadas pelo seed (obrigatórias para `pnpm db:seed`; nunca usar valores reais aqui).
DEFAULT_ADMIN_EMAIL=admin@comercialdonorte.local
DEFAULT_ADMIN_PASSWORD=replace-with-a-local-dev-password
DEFAULT_CUSTOMER_EMAIL=cliente@comercialdonorte.local
DEFAULT_CUSTOMER_PASSWORD=replace-with-a-local-dev-password
# Destinatário da equipe comercial para novas cotações (pode ser ajustado no admin).
QUOTES_SALES_EMAIL=vendas@comercialdonorte.local
# Storefront Next.js (serviço separado da API).
API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Fase 1 = catálogo + cotação. Checkout/pagamentos/treinamentos só com `true`.
FEATURE_CHECKOUT=false
FEATURE_PAYMENTS=false
FEATURE_TRAININGS=false
